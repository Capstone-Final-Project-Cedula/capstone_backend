# Application Settings
APP_NAME=CedulaSystem
APP_VERSION=1.0.0
# DEBUG=True logs every SQL statement (with citizen data) and allows any website
# to call the API. Use False for real deployments.
DEBUG=False
# Web app address(es) allowed to call the API when DEBUG=False (comma-separated)
CORS_ORIGINS=http://localhost:3000
# Generate random values, never reuse these placeholders:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-random-value

# Database — Supabase Postgres via the SESSION pooler (Dashboard > Connect > Session pooler).
# Replace [YOUR-PASSWORD] with the database password. Never commit the real value.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# Supabase Storage (CTC PDFs + citizen profile pictures). Server-side only.
# URL: Dashboard > Project Settings > API. Key: Settings > API Keys > Secret keys (sb_secret_...).
# Leave both empty to keep files on the local disk instead.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_PDF_BUCKET=ctc-pdfs
SUPABASE_PROFILE_BUCKET=profile-pictures

# Barangay local time offset from UTC (Philippines = 8)
LOCAL_UTC_OFFSET_HOURS=8

# JWT Settings
# Required. Signs every login token. Every backend that shares the Supabase
# database should use the SAME value so a login works on any of them.
JWT_SECRET_KEY=generate-a-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Whisper Settings
WHISPER_MODEL=small
# Options: tiny, base, small, medium (small recommended for short-answer accuracy;
# base is faster but noticeably weaker on names/short utterances; medium is most
# accurate but needs more RAM/CPU)
WHISPER_NO_SPEECH_THRESHOLD=0.35
WHISPER_LOGPROB_THRESHOLD=-1.5

# QR Code Settings
QR_EXPIRY_MINUTES=60

# File Paths
UPLOAD_DIR=uploads
PDF_OUTPUT_DIR=pdfs
WATERMARK_PATH=assets/barangay_seal.png

# Barangay Info (customize per deployment)
BARANGAY_NAME=Barangay San Roque
MUNICIPALITY=Mambajao
PROVINCE=Camiguin
