# REQUIRED on every machine/host: DATABASE_URL, JWT_SECRET_KEY, and (until email sending exists)
# CITIZEN_EMAIL_VERIFICATION=False.
# On a hosted (deployed) backend also set: SUPABASE_URL, SUPABASE_SECRET_KEY, DEBUG=False,
# CORS_ORIGINS=<the deployed web app URL>, CITIZEN_EMAIL_VERIFICATION=False.
# Everything else has a working default. See capstone_docs/DEPLOY.md.

# Application Settings
APP_NAME=CedulaSystem
APP_VERSION=1.0.0
# DEBUG=True logs every SQL statement (with citizen data), allows any website
# to call the API and opens /docs. Default (when unset) is False. Use False for real deployments.
DEBUG=False
# Web app address(es) allowed to call the API when DEBUG=False (comma-separated, no trailing slash).
# Deployed: the https address of the hosted web app, e.g. https://cedusync-web.example.app
CORS_ORIGINS=http://localhost:3000

# Citizen (mobile) sign-up. True = new accounts must verify their email before logging in.
# Default (when unset) is True. Set False until real email sending is added: emails are only
# logged to the console today, so with True new mobile users can never log in.
CITIZEN_EMAIL_VERIFICATION=False
# Generate random values, never reuse these placeholders:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-random-value

# Database — Supabase Postgres via the SESSION pooler (Dashboard > Connect > Session pooler).
# Replace [YOUR-PASSWORD] with the database password. Never commit the real value.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# Supabase Storage (CTC PDFs + citizen profile pictures). Server-side only.
# URL: Dashboard > Project Settings > API. Key: Settings > API Keys > Secret keys (sb_secret_...).
# Leave both empty to keep files on the local disk instead.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_PDF_BUCKET=ctc-pdfs
SUPABASE_PROFILE_BUCKET=profile-pictures

# Barangay local time offset from UTC (Philippines = 8)
LOCAL_UTC_OFFSET_HOURS=8

# JWT Settings
# Required. Signs every login token. Every backend that shares the Supabase
# database should use the SAME value so a login works on any of them.
JWT_SECRET_KEY=generate-a-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Whisper Settings
# Whisper turns each spoken interview answer into text (live session).
# base + greedy decoding: ~0.75 s per answer on a laptop CPU (recommended for a
# CPU server). small: more accurate, ~2.6 s greedy on CPU; use it with a GPU.
WHISPER_MODEL=base
# 1 = greedy decoding (fast, best for one-sentence answers); 5 = beam search (~2x slower)
WHISPER_BEAM_SIZE=1
# Load Whisper when the backend starts, so the first applicant does not wait
WHISPER_PRELOAD=True
WHISPER_NO_SPEECH_THRESHOLD=0.35
WHISPER_LOGPROB_THRESHOLD=-1.5

# QR Code Settings
QR_EXPIRY_MINUTES=60

# File Paths
UPLOAD_DIR=uploads
PDF_OUTPUT_DIR=pdfs
WATERMARK_PATH=assets/barangay_seal.png

# Barangay Info (customize per deployment)
# (Fallback only: the web Settings page values, stored in the database, take priority.)
BARANGAY_NAME=Barangay Imbatug
MUNICIPALITY=Baungon
PROVINCE=Bukidnon
